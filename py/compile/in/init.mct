$TARGET_AMOUNT = 6;

func $main () (
  for $dir in (north, east, south, west, up, down) (
    scoreboard objectives add $dir
    for $k in 1..$TARGET_AMOUNT (
      scoreboard objectives add target_$dir$k
    )
  )
  for $x in (i, ref, enabled, filter, rng, rngWeight) (
    scoreboard objectives add $x
  )
)