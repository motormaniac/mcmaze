-- inclusive ranges, counting down, negatives, variable bounds, lists, nesting
$SIZE = 1;
func $main () (
  for $i in 0..2 (
    say up $i;
  )
  for $i in 2..0 (
    say down $i;
  )
  for $i in -1..1 (
    say neg $i;
  )
  for $i in 3..3 (
    say once $i;
  )
  for $i in $SIZE..-1 (
    say var $i;
  )
  $count(2);
  for $x in (cat, dog, @e[type=rabbit,limit=1]) (
    say $x;
  )
  for $x in (  spaced  , "a, b" , $SIZE ) (
    say [$x];
  )
  for $row in 0..1 (
    for $col in (a, b) (
      say $row$col;
    )
  )
)

func $count ($n) (
  for $j in 1..$n (
    say count $j;
  )
)
