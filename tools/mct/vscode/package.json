{
  "name": "mct-syntax",
  "displayName": "MCT syntax",
  "description": "Syntax highlighting for .mct command templates (see tools/mct/LANG.md)",
  "version": "0.1.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mct",
        "aliases": [
          "MCT",
          "mct"
        ],
        "extensions": [
          ".mct"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mct",
        "scopeName": "source.mct",
        "path": "./syntaxes/mct.tmLanguage.json"
      }
    ]
  }
}
