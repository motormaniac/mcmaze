--[
# SCOREBOARDS
## dummy scoreboards
var = used for global variables
-- the walls of this cell
north   -Z
east    +X
south   +Z
west    -X
up      +Y
down    -Y
-- what wall should it connect to
for $i in 1..$TARGET_AMOUNT (
  target_north$i
  target_east$i
  target_south$i
  target_west$i
  target_up$i
  target_down$i
)
-- book keeping
edit = edit count of this cell. This prevents bfs from doubling back on itself
neighbor = 0 / null if this cell is not a neighbor. 1, 2, 3, 4, 5, 6 to mark the direction.
priority = controls what order a cell ignores its neighbors
i = index in the queue
ref = reference index to a command block array. Maps this armor stand to its command block
rng = random number
rngWeight = the weighting of a lookup entity (out of 100)

Tags:
select = this is the cell that is currently being processed
target = this is a neighbor of the select cell. There are multiple targets within one loop.
not_north, not_east, not_south, not_west, not_up, not_down = this lookup entity is not a match for the select cell on that side
enabled = this lookup entity is enabled for selection. If it is not enabled, it will be ignored.

## Lookup categories:
use tags on lookups to keep track of which category it is

## Global variables (uses the var scoreboard)
.if = boolean flag (0 or 1) used for if statement logic.
.queueSize = how many elements are in the queue
.maxEdit = once any cell exceeds this number, the algorithm fails
.maxWidth
.maxLength
.maxHeight

To generate the lookup entities, a python script creates the IR format.
The bulk place function is also created by a python script that goes straight to IR.

Queue Book keeping
push(elem): set new element's i to queueSize; queueSize += 1
pop: Get element whos i == 0; set element's i to -1; all elems i -= 1; queueSize -= 1
]--

-- One .mct file is one command chain. Each section of the old file is its own
-- chain, so each one is a function. Change what $main calls to build a different chain.
func $main () (
  $bfs_iterate();
)

-- $GRAPH, $LOOKUP, $ITEM_DISPLAY_NBT, $TARGET_AMOUNT and the positions
import const;

-- cells are 7 blocks apart
table $offset (
  north: ~ ~ ~-7,
  east: ~7 ~ ~,
  south: ~ ~ ~7,
  west: ~-7 ~ ~,
  up: ~ ~7 ~,
  down: ~ ~-7 ~,
)

-- the wall of the neighbor that faces this cell
table $opposite (
  north: south,
  east: west,
  south: north,
  west: east,
  up: down,
  down: up,
)

table $dir_to_scoreboard (
  north: 1,
  east: 2,
  south: 3,
  west: 4,
  up: 5,
  down: 6,
)

-- # Spawn start point
--[
give @p minecraft:bat_spawn_egg[item_name=start,entity_data={id:"minecraft:bat",CustomName:start}]
]--
$START = type=bat,name=start;

$IF = if score .if var matches 1;
$ELSE = if score .if var matches 0;

-- Turn the start bat into the graph node that $init pushes first
func $spawn_start () (
  #-- Spawn start point
  execute as @e[$START] at @s run summon item_display ~ ~ ~ {CustomName:graph,$ITEM_DISPLAY_NBT,Tags:[start]};
  !conditional
  kill @e[$START];
)

-- # Debug: show graph nodes
-- Diamonds for normal nodes, netherite for constraints
func $show_graph () (
  #-- Show graph nodes
  execute as @e[$GRAPH] run data merge entity @s {view_range:1,width:1,height:1};
  execute as @e[$GRAPH,tag=!constraint] run data merge entity @s {item:{id:diamond}};
  execute as @e[$GRAPH,tag=constraint] run data merge entity @s {item:{id:netherite_ingot}};
  execute as @e[$GRAPH] at @s align xyz run tp @s ~0.5 ~0.5 ~0.5;
)

-- # Init
-- Run after $spawn_start has placed the start node
func $init () (
  -- reset queue: remove the last run's nodes, but keep the constraints and the start node
  kill @e[$GRAPH,tag=!constraint,tag=!start];
  tag @e[$GRAPH,tag=select] remove select;
  scoreboard players set .queueSize var 0;
  scoreboard players set @e[$GRAPH] i -1;
  -- push starting node to queue
  scoreboard players operation @e[$GRAPH,tag=start] i = .queueSize var;
  scoreboard players add .queueSize var 1;
  scoreboard players set @e[$GRAPH,tag=start] edit 0;
  tag @e[$GRAPH,tag=start] remove start;
  scoreboard players set .randXCoordConst var -5800;
)


--[
Prioritizing multiblocks:
- we should prioritize the inner connections between multiblocks.
- These types of connections range from 1000.. so they always beat out normal encodings.

Psuedocode 2:
if there's no graph tagged select:
  pop queue
  tag select
  set priority of each neighbor:
    vary each neighbor by rng 1..5
    add the neighbor's encoding type to its property (since encodings are all unique, this will make the priority unique)
    add edit count to priority (higher edit counts are ignored last)
      edit counts are multiples of 1,000,000
    Initialize filters.
    Any lookup that has tag=notNorth means that the north neighbor IS NOT a match.
filter based on neighbor's priority
priority reset the neighbor whose priority == 0.
decrement each neighbor's priority by the priority min. This sets another neighbor to priority == 0.
if there is a possible output:
  pick random from filter results
  transfer properties to selected graph
  increment select's edit by 1,000,000
  push empty neighbors
  push neighbors whose edit is lower
  remove select from graph
]--

--[
Psuedocode 3:
if there's no graph tagged select:
  pop queue and tag select

  reset the neighbor scoreboard for all graphs
  reset lookups (remove the not_$dir tags)

  for each neighbor:
    mark neighbor as target
    if target exists:
      set scoreboard neighbor to north: 1, east: 2, south: 3, west: 4, up: 5, down: 6
      set priority:
      only set the priority of non-constraints. This means that constraints are never ignored, because they are not marked in the priority list.
      vary rng by 1..10
      add the neighbor's encoding type to its property (since encodings are all unique, this will make the priority unique)
      add edit count to priority (higher edit counts are ignored last)
        edit counts are multiples of 1,000,000
      
      find all lookups that match this target on that side. Add the tag not_$dir.
      
    if target is empty:
      create graph node in that direction
  
if the the only neighbors are constraints, then remove select from graph

set the direction to test by finding the neighbor with priority == 0.
  On the first iteration, this process will select no neighbors.
remove the tag not_$dir from all lookups.

requeue the neighbor whose priority == 0 to override it.

remove the filter tag from all lookups.
tag all lookups[tag=not_north, tag=not_east...tag=not_down] add filter

if filter exists
  pick random from filter results
  transfer properties to selected graph
  increment select's edit by 1,000,000
]--

$STOP_LOOP = setblock -78 3 3 air;

func $bfs_iterate() (
  -- If the queue is empty, end the loop
  #-- Write Stop Loop
  execute unless entity @e[$GRAPH,tag=select] if score .queueSize var matches ..0 run $STOP_LOOP;
  #-- Write Stop Loop
  execute as @e[$GRAPH] if score @s edit > .maxEdit var run $STOP_LOOP;

  -- if there is no graph tagged select
  #-- If there's no select, choose select and pop queue
  scoreboard players set .if var 0;
  execute unless entity @e[$GRAPH,tag=select] run scoreboard players set .if var 1;
  execute $IF run tag @e[$GRAPH,scores={i=0}] add select;
  -- pop queue
  execute $IF run scoreboard players set @e[$GRAPH,tag=select] i -1;
  execute $IF run scoreboard players remove @e[$GRAPH,scores={i=1..}] i 1;
  execute $IF run scoreboard players remove .queueSize var 1;

  #-- reset neighbors
  execute $IF run scoreboard players reset @e[$GRAPH] priority;
  execute $IF run scoreboard players reset @e[$GRAPH] neighbor;
  #-- reset lookup
  for $dir in (north, east, south, west, up, down) (
    execute $IF run tag @e[$LOOKUP,tag=not_$dir] remove not_$dir;
  )

  --------------------------------------

  for $dir in (north, east, south, west, up, down) (
    #-- mark neighbor as target
    execute $IF as @e[$GRAPH,tag=select] at @s positioned $offset[$dir] run tag @n[distance=..1,$GRAPH] add target;
    execute $IF run scoreboard players set @e[$GRAPH,tag=target] neighbor $dir_to_scoreboard[$dir];
    -- store .target, for filtering. -1 means null.
    execute $IF run scoreboard players set .target var -1;
    execute $IF run scoreboard players operation .target var = @n[$GRAPH,tag=target] $opposite[$dir];

    #-- filter lookups on side $dir
    execute $IF
      unless score .target var matches -1
      as @e[$LOOKUP]
      for $k in 1..$TARGET_AMOUNT (
        unless score @s target_$dir$k = .target var
      )
      run tag @s add not_$dir;

    #-- prioritize $dir
    -- only set priority if .target is not null.
    -- ignoring constraint graphs means that those sides will never be ignored since they aren't in the priority list.
    -- Constraint nodes will always be considered.
    -- rng(1..10) + neighbor's encoding type + edit count
    execute $IF unless score .target var matches -1 as @n[$GRAPH,tag=target,tag=!constraint] store result score @s priority run random value 1..10;
    execute $IF unless score .target var matches -1 as @n[$GRAPH,tag=target,tag=!constraint] run scoreboard players operation @s priority += .target var;
    execute $IF unless score .target var matches -1 as @n[$GRAPH,tag=target,tag=!constraint] run scoreboard players operation @s priority += @s edit;

    #-- Create and push empty neighbor towards $dir
    -- only create a new neighbor if there is no target in that direction
    execute $IF unless entity @n[$GRAPH,tag=target] as @n[$GRAPH,tag=select] at @s run summon item_display $offset[$dir] {CustomName:graph,$ITEM_DISPLAY_NBT,Tags:[new]};
    execute $IF as @e[$GRAPH,tag=new] unless score @s i matches 0.. run scoreboard players operation @s i = .queueSize var;
    !conditional
    scoreboard players add .queueSize var 1;

    tag @e[$GRAPH,tag=target] remove target;
  )
  
  #-- Initialize new empty neighbors
  execute $IF run scoreboard players set @e[$GRAPH,tag=new] edit 0;
  -- set all sides to -1
  for $dir in (north, east, south, west, up, down) (
    execute $IF run scoreboard players set @e[$GRAPH,tag=new] $dir -1;
  )
  tag @e[$GRAPH,tag=new] remove new;

  --------------------------------------

  -- filter happens before ignore side so that the first case is that all the sides are included.
  #-- Filter lookups
  tag @e[$LOOKUP,tag=enabled,
    for $dir in (north, east, south, west, up, down) sep "," (
      tag=!not_$dir
    )
  ] add filter;

  #-- if select and filter entities exist
  scoreboard players set .if var 0;
  execute if entity @e[$GRAPH,tag=select] if entity @e[$LOOKUP,tag=filter] run scoreboard players set .if var 1;

  #-- Pick random from filter results
  --[
  assume the scoreboard .randXCoordConst is already initialized to a valid number.
  rand x coord const should be an x coordinate multipled by 100.
  assume the entity randChoose already exists

  Imagine each multiple of 100 is one block. In real space, the lookup entities are positioned at these random coordinates.
  The randChoose entity is positioned such that the highest lookup is closest to it.
  Adding or subtracting up to 100 from the random value will move the lookup entity by at most one block.
  ]--
  execute $IF as @e[$LOOKUP,tag=filter] store result score @s rng run random value 0..100;
  execute $IF as @e[$LOOKUP,tag=filter] run scoreboard players operation @s rng += @s rngWeight;
  execute $IF run scoreboard players operation @e[$LOOKUP,tag=filter] rng += .randXCoordConst var;
  -- set the x coordinate of each lookup to its random value
  execute $IF as @e[$LOOKUP,tag=filter] store result entity @s Pos[0] float 0.01 run scoreboard players get @s rng;
  execute $IF as @e[type=item_display,name=randChoose] at @s run tag @n[$LOOKUP,tag=filter] add select;

  #-- Transfer the properties from selected lookup to the selected graph
  execute $IF run scoreboard players operation @e[$GRAPH,tag=select] ref = @e[$LOOKUP,tag=select] ref;
  for $dir in (north, east, south, west, up, down) (
    execute $IF run scoreboard players operation @e[$GRAPH,tag=select] $dir = @e[$LOOKUP,tag=select] $dir;
    for $k in 1..$TARGET_AMOUNT (
      execute $IF run scoreboard players operation @e[$GRAPH,tag=select] target_$dir$k = @e[$LOOKUP,tag=select] target_$dir$k;
    )
  )

  execute $IF run scoreboard players add @e[$GRAPH,tag=select] edit 1000000;
  #-- cleanup
  tag @e[$LOOKUP,tag=filter] remove filter;
  tag @e[$LOOKUP,tag=select] remove select;
  execute $IF run tag @e[$GRAPH,tag=select] remove select;
  
  --------------------------------------

  
  #-- Find the next neighbor to ignore
  -- clear every node at 0: tied nodes were all ignored and pushed together last tick
  scoreboard players reset @e[$GRAPH,scores={priority=0}] priority;
  -- decrement each neighbor's priority so that one of them is 0
  scoreboard players set .min var 2147483647;
  execute as @e[$GRAPH,scores={priority=0..}] run scoreboard players operation .min var < @s priority;
  scoreboard players operation @e[$GRAPH,scores={priority=0..}] priority -= .min var;
  
  #-- If there's still a select and the priority list is not empty
  scoreboard players set .if var 0;
  execute if entity @e[$GRAPH,tag=select] if entity @e[$GRAPH,scores={priority=0..}] run scoreboard players set .if var 1;
  -- if the priority list is empty, then remove select from graph
  #-- If a single cell gives up, stop the loop
  execute $ELSE run $STOP_LOOP;
  
  #-- Ignore and push every side at priority 0
  -- Neighbors that tie are ignored and pushed in the same tick. Each side has at most one neighbor,
  -- so the conditional queueSize += 1 counts each push once.
  for $dir in (north, east, south, west, up, down) (
    -- push before the neighbor score is reset, since the push finds the node by it
    execute $IF as @e[$GRAPH,scores={priority=0,neighbor=$dir_to_scoreboard[$dir]}] unless score @s i matches 0.. run scoreboard players operation @s i = .queueSize var;
    !conditional
    scoreboard players add .queueSize var 1;
    execute $IF run scoreboard players reset @e[$GRAPH,scores={priority=0,neighbor=$dir_to_scoreboard[$dir]}] neighbor;
    !conditional
    tag @e[$LOOKUP,tag=not_$dir] remove not_$dir;
  )
)