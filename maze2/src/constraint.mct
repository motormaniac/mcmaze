import const;

$CONSTRAINT = type=bat,name=constraint;
$CONSTRAINT_ENCODING_TYPE = 0;


--[
give @p minecraft:bat_spawn_egg[item_name=constraint,entity_data={id:"minecraft:bat",CustomName:constraint}]
]--

func $spawn_constraint () (
  execute as @e[$CONSTRAINT] at @s run summon item_display ~ ~ ~ {CustomName:graph,$ITEM_DISPLAY_NBT,Tags:[new,constraint]};
  kill @e[$CONSTRAINT];
  for $dir in (north, east, south, west, up, down) (
    scoreboard players set @e[$GRAPH,tag=constraint,tag=new] $dir $CONSTRAINT_ENCODING_TYPE;
  )
  tag @e[$GRAPH,tag=constraint,tag=new] remove new;
)

-- give @p minecraft:bat_spawn_egg[item_name=removeConstraint,entity_data={id:"minecraft:bat",CustomName:removeConstraint}]
func $remove_constraint () (
  execute as @e[type=bat,name=removeConstraint] at @s run kill @n[$GRAPH,tag=constraint];
  kill @e[type=bat,name=removeConstraint];
)

func $remove_all_constraints() (
  execute as @e[$GRAPH,tag=constraint] at @s run setblock ~ ~ ~ air;
  kill @e[$GRAPH,tag=constraint];
)

-- Test cases from maze2/manual_test/TESTS.md: each one enables only its test's category
func $enable_category ($category) (
  tag @e[$LOOKUP] remove enabled;
  tag @e[$LOOKUP,tag=cat_$category] add enabled;
)

func $enable_test_cases() (
  #-- Test 1: basic
  $enable_category(t_basic);
  #-- Test 2: three targets
  $enable_category(t_slots);
  #-- Test 3: nothing fits
  $enable_category(t_nofit);
  #-- Test 4: dominoes
  $enable_category(t_domino);
  #-- Test 5: dominoes that can't pair up
  $enable_category(t_domino);
  #-- Test 6: triominoes, 10 cells
  $enable_category(t_tri);
  #-- Test 7: triominoes, 9 cells
  $enable_category(t_tri);
  #-- Test 8: triominoes stress, 12 cells
  $enable_category(t_tri);
)

func $place_single_constraint($offset) (
  execute as @e[type=item_display,name=placeConstraints] at @s run summon item_display $offset {CustomName:graph,$ITEM_DISPLAY_NBT,Tags:[constraint]};
)

-- the dimensions of the outer bounds (so subtract 2 from each to get the inner bounds)
$WIDTH = 13;
$LENGTH = 13;
$HEIGHT = 4;
-- one less than each dimension above (no arithmetic in .mct, so keep these in sync by hand)
$WIDTH_INNER_END = 12;
$LENGTH_INNER_END = 12;

-- places one constraint on every cell of the outer shell, each exactly once:
-- the west/east faces take their full area, the north/south faces skip the x edges
-- the west/east faces already cover, and the bottom/top faces skip both
func $place_constraints() (
  #-- west and east faces
  for $x in (0, $WIDTH) (
    for $y in 0..$HEIGHT (
      for $z in 0..$LENGTH (
        $place_single_constraint(~$x ~$y ~$z);
      )
    )
  )
  #-- north and south faces
  for $z in (0, $LENGTH) (
    for $x in 1..$WIDTH_INNER_END (
      for $y in 0..$HEIGHT (
        $place_single_constraint(~$x ~$y ~$z);
      )
    )
  )
  #-- bottom and top faces
  for $y in (0, $HEIGHT) (
    for $x in 1..$WIDTH_INNER_END (
      for $z in 1..$LENGTH_INNER_END (
        $place_single_constraint(~$x ~$y ~$z);
      )
    )
  )
)


func $main() (
  -- #-- Spawn constraint
  -- $spawn_constraint();
  -- #-- Remove constraint
  -- $remove_constraint();
  #-- place_constraints
  $place_constraints();
)