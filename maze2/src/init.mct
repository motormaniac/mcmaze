import const;

func $main () (
  for $dir in (north, east, south, west, up, down) (
    scoreboard objectives add $dir dummy;
    for $k in 1..$TARGET_AMOUNT (
      scoreboard objectives add target_$dir$k dummy;
    )
  )
  for $x in (var, edit, priority, i, ref, enabled, rng, rngWeight) (
    scoreboard objectives add $x dummy;
  )
)